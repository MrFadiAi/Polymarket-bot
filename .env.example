POLYMARKET_PRIVATE_KEY=your_private_key_here
CAPITAL_USD=50
DRY_RUN=true # true for testing, false for real trading

# Polygon RPC endpoint (explicit > POLYGON_RPC_URL > public fallback).
# Set this to your own node (e.g. Alchemy/Infura/QuickNode) — the public
# endpoint is rate-limited and unreliable for live trading.
POLYGON_RPC_URL=https://polygon-rpc.com

# RISK MANAGEMENT (optional — defaults shown; fractions of CAPITAL_USD)
DAILY_MAX_LOSS_PCT=0.05
MONTHLY_MAX_LOSS_PCT=0.15
MAX_DRAWDOWN_PCT=0.25
TOTAL_MAX_LOSS_PCT=0.40

# DASHBOARD SECURITY (optional)
# Bind address for the dashboard server (default 127.0.0.1 = localhost only;
# set 0.0.0.0 only if you must reach it from other machines)
# DASHBOARD_HOST=127.0.0.1
# Shared secret required on /api/* and the WebSocket when set.
# The bot prints the full dashboard URL (including ?token=...) at startup.
# DASHBOARD_TOKEN=generate-a-long-random-string

# STRATEGIES CONFIG false as defualt
ARBITRAGE_ENABLED=false
DIPARB_ENABLED=false
SMARTMONEY_ENABLED=false
TREND_ANALYSIS_ENABLED=false
